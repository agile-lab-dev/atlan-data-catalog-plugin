# Copy to `.env` (git-ignored) in this directory before running the service locally.
# These are the only values that must never go into `config/application.yaml`.

ATLAN_OAUTH_CLIENT_ID=your-oauth-client-id
ATLAN_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Optional: path to the non-secret YAML config file (see config/application-sample.yaml).
# Defaults to "config/application.yaml" in the working directory the service is started from.
# ATLAN_CONFIG_FILE=config/application.yaml

# Optional: any other AtlanSettings field can also be overridden here as
# ATLAN_<FIELD_NAME>, taking precedence over config/application.yaml, e.g.:
# ATLAN_BASE_URL=https://your-tenant.atlan.com
